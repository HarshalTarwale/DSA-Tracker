# Neon Postgres connection string (use the *pooled* URL from the Neon dashboard)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The single password used to log in to the app
APP_PASSWORD="dsa1234"

# At least 32 random characters. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"
